# Copia este archivo como keystore.properties (ya está en .gitignore) y completa tus datos.
# Alternativa: variables de entorno TURKIDS_STORE_FILE, TURKIDS_STORE_PASSWORD, TURKIDS_KEY_ALIAS y TURKIDS_KEY_PASSWORD.
# storeFile es relativo a la raíz del proyecto (o una ruta absoluta).
storeFile=keystore/turkids-release.jks
storePassword=CAMBIAR
keyAlias=turkids
keyPassword=CAMBIAR
